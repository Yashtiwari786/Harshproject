{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(css|js|uploads)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/admin/(.*)\\.html",
      "dest": "/public/admin/$1.html"
    },
    {
      "src": "/admin/?(.*)",
      "dest": "/public/admin/dashboard.html"
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/public/$1.html"
    },
    {
      "src": "/(login|register|verify|dashboard|lost-items|found-items|report-lost|report-found|item|claim|notifications|profile|how-it-works|about)",
      "dest": "/public/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
